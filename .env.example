DATABRICKS_HOST=https://seu-workspace.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_MDS_AUTH_USER=
DASHBOARD_MDS_AUTH_PASSWORD=

# Lista de company_key separadas por vírgula. Use * somente para administradores internos.
# Se a variável full não existir, o usuário administrativo legado recebe *;
# defina uma string vazia para bloquear tudo explicitamente.
DASHBOARD_AUTH_COMPANY_SCOPES=*
DASHBOARD_MDS_COMPANY_SCOPES=

# OBRIGATÓRIO: assina o cookie de sessão. Sem esta variável o login falha
# (não há mais fallback para a senha). Gere com `openssl rand -base64 48`.
DASHBOARD_SESSION_SECRET=

# Origens permitidas para CORS (separadas por vírgula). Sem valor, nenhuma
# origem cross-site é liberada — o dashboard segue funcionando por ser
# same-origin. Ex.: https://estrategia.sanus.tech
DASHBOARD_ALLOWED_ORIGINS=
