DATABRICKS_HOST=https://seu-workspace.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_MDS_AUTH_USER=
DASHBOARD_MDS_AUTH_PASSWORD=

# Lista de company_key separadas por vírgula. Use * somente para administradores internos.
# Se a variável full não existir, o usuário administrativo legado recebe *;
# defina uma string vazia para bloquear tudo explicitamente.
DASHBOARD_AUTH_COMPANY_SCOPES=*
DASHBOARD_MDS_COMPANY_SCOPES=

# OBRIGATÓRIO: assina o cookie de sessão. Sem esta variável o login falha
# (não há mais fallback para a senha). Gere com `openssl rand -base64 48`.
DASHBOARD_SESSION_SECRET=

# Origens permitidas para CORS (separadas por vírgula). Sem valor, nenhuma
# origem cross-site é liberada — o dashboard segue funcionando por ser
# same-origin. Ex.: https://estrategia.sanus.tech
DASHBOARD_ALLOWED_ORIGINS=

# --- Tela "Configurações" (permissão de menu por usuário) ---
# Sem estas variáveis, a tela fica ilegível/só leitura e o dashboard continua
# funcionando exatamente como hoje (sem nenhuma restrição nova).
#
# 1) No projeto na Vercel: Storage → Create Database → Edge Config → conecte
#    ao projeto. A Vercel injeta EDGE_CONFIG automaticamente (string de
#    conexão de LEITURA) — não precisa copiar isso à mão.
# EDGE_CONFIG é injetada automaticamente pela Vercel, não defina aqui.

# 2) Para poder ESCREVER (criar/editar usuários pela tela), gere um token em
#    vercel.com/account/tokens e copie o ID do Edge Config criado no passo 1
#    (Storage → seu Edge Config → aparece como "ecfg_...").
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
# Só necessário se o token pertence a uma conta de time (não a uma conta
# pessoal). Encontra-se em Team Settings → General → Team ID.
VERCEL_TEAM_ID=
