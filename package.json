{
  "name": "sanus-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "databricks:sinistralidade:plan": "node scripts/deploy-sinistralidade-v2.mjs",
    "databricks:sinistralidade:apply": "node scripts/deploy-sinistralidade-v2.mjs --apply",
    "databricks:sinistralidade:close-month": "node scripts/close-sinistralidade-month.mjs",
    "databricks:sinistralidade:onboard": "node scripts/onboard-sinistralidade-company.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/edge-config": "^1.5.0",
    "next": "^16.3.5",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.4"
  }
}
